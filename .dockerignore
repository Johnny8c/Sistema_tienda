# Reducir el contexto del build para acelerar `docker build`
.git
.github
.gitignore
.vscode
.idea
.claude
.pytest_cache
.mypy_cache
.ruff_cache

# Entornos virtuales locales
.venv
venv/
env/
ENV/

# Compilados Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Node (por si entra algo)
node_modules/

# Bases locales y media
db.sqlite3
db.sqlite3-journal
media/

# Staticos: los regenera collectstatic dentro del build
staticfiles/

# Secrets — el .env real lo monta docker-compose desde el host
.env
.env.*
!.env.example

# Logs y temporales
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
