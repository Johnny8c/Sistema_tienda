# ─────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — Sistema Tienda
# Copia este archivo a .env para desarrollo local.
# En Railway, configura cada variable en Project → Variables.
# ─────────────────────────────────────────────────────────────

# === Núcleo Django ===
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DEBUG=True
# En producción (Railway) usa DEBUG=False y agrega tu dominio en ALLOWED_HOSTS,
# separado por comas. Ej.: ALLOWED_HOSTS=tienda-production.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# === Base de datos ===
# En local puede dejarse vacío para usar sqlite. En Railway, esta variable
# la inyecta automáticamente el plugin de Postgres (referencia ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# === Almacenamiento de imágenes (Cloudinary) ===
# Crea cuenta gratis en cloudinary.com → Dashboard → API Environment variable.
# Si lo dejas vacío, las fotos se guardan localmente (no recomendado en Railway).
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# === Seguridad / CSRF ===
# Lista de orígenes confiables para POST en HTTPS (separados por coma).
# Por defecto cubre *.up.railway.app. Añade aquí tu dominio propio si tienes.
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.railway.app

# ─────────────────────────────────────────────────────────────
# Aviso de pago al proveedor del sistema (visible solo al dueño)
# Si DEV_PAGO_FECHA está vacío → el banner NO aparece.
# Cuando te paguen, actualiza DEV_PAGO_FECHA al siguiente vencimiento.
# ─────────────────────────────────────────────────────────────
DEV_PAGO_FECHA=2026-06-15
DEV_PAGO_MONTO=15.00
DEV_PAGO_MONEDA=USD
DEV_PAGO_CONCEPTO=Hosting + soporte mensual del sistema
DEV_PAGO_CONTACTO_NOMBRE=Johnny Caivinagua
DEV_PAGO_CONTACTO_TELEFONO=+593997303865
DEV_PAGO_CONTACTO_EMAIL=leocaivinagua@gmail.com
DEV_PAGO_INSTRUCCIONES=Banco Pichincha · Ahorros · 2200000000 · CI 0150137917

# ─────────────────────────────────────────────────────────────
# Datos del proveedor del sistema en los comprobantes SRI
# Resolución NAC-DGERCGC26-00000027: cada comprobante debe llevar en
# infoAdicional el RUC del proveedor del software (NO el del emisor ni el
# del cliente). Es un valor global del sistema, no por negocio.
#
# Solo SRI_PROVEEDOR_RUC es obligatorio por la norma. Los demás son datos
# de contacto opcionales: si dejas la variable vacía, el campo no se emite
# ni en el XML ni en el pie del RIDE.
#
# SRI_PROVEEDOR_CAMPO_RUC existe por si el SRI publica un nombre de campo
# distinto en la ficha técnica: se cambia aquí sin tocar código.
# ─────────────────────────────────────────────────────────────
SRI_PROVEEDOR_RUC=0150137917001
SRI_PROVEEDOR_NOMBRE=JOHNNY CAIVINAGUA MOROCHO
SRI_PROVEEDOR_EMAIL=leocaivinagua@gmail.com
SRI_PROVEEDOR_TELEFONO=0997303865
SRI_PROVEEDOR_CAMPO_RUC=RUC Proveedor
SRI_PROVEEDOR_CAMPO_NOMBRE=Razon Social Proveedor
SRI_PROVEEDOR_CAMPO_EMAIL=Email Proveedor
SRI_PROVEEDOR_CAMPO_TELEFONO=Telefono Proveedor
